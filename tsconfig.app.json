{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    // The visualization engine (src/engine) and the step generators (src/content/topics)
    // are plain ES modules in JavaScript. Their boundaries are typed in
    // src/content/registry.ts and their behaviour is covered by unit tests.
    "allowJs": true,
    "checkJs": false,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
