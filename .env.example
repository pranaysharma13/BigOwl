# Copy to .env.local for local development, and set the same names in Vercel
# (Project Settings > Environment Variables). Both values are public by design;
# row-level security in the database is what protects each user's data.
# Never put the service_role / secret key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
